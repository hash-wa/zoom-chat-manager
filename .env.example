# Password required to log into the app.
APP_PASSWORD=change-me

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Optional. Leave both unset for local dev - the app falls back to a local
# SQLite file at data/app.db, no Turso account needed. Set both when
# deploying to Vercel (or anywhere without persistent local disk), pointing
# at a Turso database - see README's "Deploying" section.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
